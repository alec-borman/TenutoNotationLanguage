    ]>
    lh: [c2 g2 c3]:1.ped |
}

measure 2 {
    rh: <[
        v1: d5:2..tr c5:8 bn4:8 |
        v2: r:4 [d4 f4 g4]:2. |
    ]>
    lh: [g1 d2 g2]:1 |
}

