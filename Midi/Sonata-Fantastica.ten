        v1: (bn5:8 c6 d6):3/2 (eb6:8 d6 c6):3/2 bn5:2 |
        v2: r:2 [d4 g4 bn4]:2 |
    ]>
    lh: [g1 d2 g2]:1 |
}

measure 7 {
    rh: <[
        v1: ab5:2..f f5:4 |
        v2: [c4 f4 ab4]:1 |
    ]>
    lh: [f1 c2 f2]:1 |
}

measure 8 {
    meta @{ tempo: [1, 2], curve: "exp" }
    rh: <[
        v1: g5:1..ff |
        v2: [bn3 d4 g4]:1 |
    ]>
    lh: [g1 d2 g2]:1 |
}

%% SECTION C: Agitato - The French Jeu Perlé
measure 9 {
    meta @{ tempo: 120 }
    rh: c5:16..p.stacc d5 eb5 f5 g5 ab5 bn5 c6 d6 eb6 f6 g6 ab6 bn6 c7 d7 |
    lh: [c2 g2 c3]:1 |
}

measure 10 {
