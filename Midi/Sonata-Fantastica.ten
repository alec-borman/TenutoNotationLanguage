tenuto "2.2" {

meta @{
    title: "Sonata-Fantasia in C Minor: Echoes of the Abyss",
    composer: "The Master Architect",
    time: "4/4",
    tempo: 45,
    key: "Cm"
}

%% 1. DEFINITIONS (The Physics)
def rh "Right Hand" style=standard clef=treble
def lh "Left Hand" style=standard clef=bass

%% SECTION A: The Lament (Russian School Sonority)
measure 1 {
    rh: <[
        v1: r:4 g4:4..p.text("pesante") c5:8 eb5:4 |
        v2: r:1 |
    ]>
    lh: [c2 c3]:1.ped |
}

measure 2 {
    rh: <[
        v1: d5:2..tr c5:8 bn4:8 |
        v2: r:4 [d4 f4 g4]:2. |
    ]>
    lh: [g1 g2]:1 |
}

measure 3 {
    rh: <[
        v1: c5:4..mp eb5:8 g5:4 c6:4 |
        v2: r:2 [c4 eb4 g4]:2 |
    ]>
    lh: [ab1 ab2]:1 |
}

measure 4 {
    rh: <[
        v1: bn5:2..tr.text("dim.") g5:4 |
        v2: [d4 f4 g4]:1 |
    ]>
    lh: [g1 g2]:1 |
}

%% SECTION B: Expanding the Pianto Motif
measure 5 {
    rh: <[
        v1: (c6:8 d6 eb6):3/2 (f6:8 eb6 d6):3/2 c6:2 |
        v2: r:2 [eb4 g4 c5]:2 |
    ]>
    lh: [c2 g2 c3]:1 |
}

measure 6 {
