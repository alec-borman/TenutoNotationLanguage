  lh: d1:1.ped.arp |
  rh: [c5 f5 a5 c6 f6 a6 c7]:1.arp |
}

measure 64 {
  lh: g0:1.ped.arp |
  rh: [b4 d5 f5 g5 b5 d6 f6]:1.arp |
}

measure 65 {
  lh: c2:2.fff.ped [g2 c3 e3]:2 |
  rh: [c6 e6 g6 c7]:2.marc [d6 f6 a6 d7]:2 |
}

measure 66 {
  lh: g1:2.ped [d2 g2 b2]:2 |
  rh: [e6 g6 c7 e7]:2.marc [f6 g6 d7 f7]:2 |
}

measure 67 {
  lh: e2:2.ped [c3 e3 a3 c4]:2 |
  rh: [g6 c7 e7 g7]:2.marc [a6 c7 f7 a7]:2 |
}

measure 68 {
  lh: g2:2.ped [g1 d2 g2]:2 |
  rh: [g6 c7 e7 g7]:2.marc [f6 b6 d7 f7]:2 |
}

measure 69 {
  lh: c2:1.ped |
  rh: (c7:8 e7 g7):3/2 (c8:8 g7 e7):3/2 (c7:8 g6 e6):3/2 (c6:8 g5 e5):3/2 |
}

measure 70 {
  lh: f1:1.ped |
  rh: (c5:8 f5 a5):3/2 (c6:8 f6 a6):3/2 (c7:8 f7 a7):3/2 (c8:8 a7 f7):3/2 |
}

measure 71 {
  lh: d1:1.ped |
  rh: (c7:8 a6 f6):3/2 (c6:8 a5 f5):3/2 (c5:8 a4 f4):3/2 (c4:8 f4 a4):3/2 |
}

measure 72 {
  lh: g0:1.ped |
  rh: (b4:8 d5 f5):3/2 (g5:8 b5 d6):3/2 (f6:8 g6 b6):3/2 (d7:8 f7 g7):3/2 |
}

%% ==============================================================================
%% SECTION G: CODA (Measures 73-80)
%% Sweeping virtuoso cadenza ending in a spectral evaporation into silence.
%% ==============================================================================

measure 73 {
  meta @{ tempo: [1, 6], curve: "linear" }
  lh: c1:1.ff.ped | 
  rh: c8:32 g7 e7 c7 g6 e6 c6 g5 e5 c5 g4 e4 c4 g3 e3 c3 c3 e3 g3 c4 e4 g4 c5 e5 g5 c6 e6 g6 c7 e7 g7 c8 |
}

measure 74 {
  lh: f0:1.ped | 
  rh: a7:32 f7 c7 a6 f6 c6 a5 f5 c5 a4 f4 c4 a3 f3 c3 a2 a2 c3 f3 a3 c4 f4 a4 c5 f5 a5 c6 f6 a6 c7 f7 a7 |
}

measure 75 {
  lh: g0:1.ped | 
  rh: b7:32 g7 f7 d7 b6 g6 f6 d6 b5 g5 f5 d5 b4 g4 f4 d4 d4 f4 g4 b4 d5 f5 g5 b5 d6 f6 g6 b6 d7 f7 g7 b7 |
}

measure 76 {
  meta @{ tempo: [6, 7], curve: "linear" }
  lh: c1:2.ped [c1 c2]:2.fermata | 
  rh: c8:32 g7 e7 c7 g6 e6 c6 g5 e5 c5 g4 e4 c4 g3 e3 c3 [c3 e3 g3 c4]:2.fermata |
}

measure 77 {
  meta @{ tempo: 60 }
  lh: c2:1.p.ped.arp | 
  rh: [e5 g5 c6 e6]:1.arp |
}

measure 78 {
  lh: f1:1.ped.arp | 
  rh: [f5 a5 c6 f6]:1.arp |
}

measure 79 {
  meta @{ tempo: [7, 8], curve: "linear" }
  lh: g1:1.pp.ped.arp | 
  rh: [d5 f5 b5 d6]:1.arp |
}

measure 80 {
  lh: [c1 c2]:1.ppp.fermata.ped_up | 
  rh: [c5 e5 g5 c6]:1.fermata |
}

}