    rh: [d3 f3 bn3]:1 |
}
measure 78 {
    lh: [c1 c2]:1.ped |
    rh: [c3 eb3 g3 c4]:1 |
}
measure 79 {
    lh: [c1 c2]:1.ped |
    rh: [c3 eb3 g3 c4]:1.text("dim.") |
}
measure 80 {
    lh: [c0 c1]:1.ppp.fermata.ped_up |
    rh: [c2 g2 c3 eb3]:1.ppp.fermata |
}

}