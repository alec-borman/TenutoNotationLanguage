    rh: [ab3 c4 f4]:4 [g3 d4 f4]:4 [g3 c4 eb4]:2 |
}
measure 75 {
    meta @{ tempo: [23, 24], curve: "linear" }
    lh: [f1 f2]:4 [g1 g2]:4 [ab1 ab2]:2 |
    rh: [f3 ab3 c4]:4 [g3 bn3 d4]:4 [ab3 c4 eb4]:2 |
}
measure 76 {
