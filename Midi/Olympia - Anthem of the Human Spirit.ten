    lh: [bb0 bb1]:1 | 
    rh: [bb4 eb5 g5 bb5]:2 [bb4 d5 f5 bb5]:2 |
}

%% ==========================================
%% Section B: The Olympic Theme (Maestoso)
%% ==========================================
measure 9 {
    lh: [eb2 bb2 eb3]:2 [d2 bb2 d3]:2 | 
    rh: eb5:2..f g5:8 |
}
measure 10 {
    lh: [c2 g2 c3]:2 [g1 d2 g2]:2 | 
