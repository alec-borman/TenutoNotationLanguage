}
measure 2 {
    lh: [bb0 bb1]:1 | 
    rh: [d4 f4 bb4 d5]:4. [d4 f4 bb4 d5]:16 [d4 f4 bb4 d5]:16 [f5 bb5 d6 f6]:2 |
}
measure 3 {
    lh: [ab0 ab1]:1 | 
    rh: [c4 eb4 ab4 c5]:4. [c4 eb4 ab4 c5]:16 [c4 eb4 ab4 c5]:16 [eb5 ab5 c6 eb6]:2 |
}
measure 4 {
    lh: [bb0 bb1]:1 | 
    rh: (bb5:8 c6 d6):3/2 (eb6:8 f6 g6):3/2 [ab6 c7]:2 |
}
