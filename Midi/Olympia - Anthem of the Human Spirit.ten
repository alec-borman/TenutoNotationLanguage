    rh: ab5:4. g5:16 f5:16 g5:2 |
}
measure 21 {
    lh: [c2 g2 c3]:2 [f1 c2 f2]:2 | 
    rh: g5:4 ab5:4 bb5:4 c6:4 |
}
measure 22 {
    lh: [d2 a2 d3]:2 [g1 d2 g2]:2 | 
    rh: d6:4 eb6:4 f6:4 g6:4 |
}
measure 23 {
    lh: [c2 g2 c3]:2 [f1 c2 ab2]:2 | 
    rh: ab6:4 g6:4 f6:4 eb6:4 |
}
measure 24 {
    lh: [bb1 f2 bb2]:2 [bb0 f1 bb1]:2 | 
    rh: d6:4. c6:16 d6:16 eb6:2 |
}

%% ==========================================
%% Section C: Theme A Orchestral Octaves
%% ==========================================
measure 25 {
    lh: [eb1 eb2]:4 [bb1 bb2]:4 [eb2 eb3]:2 | 
    rh: [eb5 eb6]:2..ff [g5 g6]:8 |
}
