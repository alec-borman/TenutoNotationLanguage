    rh: d6:4. c6:16 bb5:16 c6:2 |
}
measure 15 {
    lh: [ab1 eb2 ab2]:2 [f1 c2 f2]:2 | 
    rh: eb6:2.. d6:8 |
}
measure 16 {
    lh: [bb1 f2 bb2]:1 | 
    rh: c6:4. bb5:16 ab5:16 bb5:2 |
}
measure 17 {
    lh: [eb2 bb2 eb3]:2 [d2 bb2 d3]:2 | 
    rh: eb5:2..f g5:8 |
}
measure 18 {
