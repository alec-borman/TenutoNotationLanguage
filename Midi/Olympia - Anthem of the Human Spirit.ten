tenuto "2.2" {

meta @{
    title: "Olympia: Anthem of the Human Spirit",
    composer: "AI Master Composer",
    time: "4/4",
    tempo: 108,
    key: "Eb"
}

%% Instrument Definitions
def rh "Right Hand" style=standard clef=treble
def lh "Left Hand" style=standard clef=bass

%% ==========================================
%% Section A: The Heroic Fanfare (Intro)
%% ==========================================
measure 1 {
    lh: [eb1 eb2]:1.ped | 
