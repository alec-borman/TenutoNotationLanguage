    rh: [c6 eb6 ab6 c7]:2 [bb5 d6 f6 bb6]:2 |
}
measure 56 {
    meta @{ tempo: [6, 7], curve: "linear" }
    lh: (bb0:8 bb0 bb0):3/2 (bb0:8 bb0 bb0):3/2 [bb0 bb1]:2 | 
    rh: [ab5 c6 eb6 ab6]:2 [f5 bb5 d6 f6]:2 |
}

