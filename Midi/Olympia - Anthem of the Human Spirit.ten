tenuto "3.0" {
    meta @{
        title: "Olympia - Anthem of the Human Spirit",
        composer: "AI Master Composer",
        time: "4/4",
        key: "Eb"
    }

    %% V3.0 Definition Phase: Routing the cognitive engines.
    def rh "R.H." style=relative patch="gm_piano"
    def lh "L.H." style=standard patch="gm_piano"

    %% ==============================================================================
