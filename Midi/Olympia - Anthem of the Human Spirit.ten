    rh: <[ v1: eb5:4. db5:8 c5:2 | v2: [ab4 c5]:1 | ]>
}
measure 45 {
    lh: [ab1 eb2 c3]:1.text("cresc.") | 
    rh: c6:2.. bb5:8 |
}
measure 46 {
    lh: [c2 g2 e3]:1 | 
    rh: d6:4. c6:8 d6:2 |
}
measure 47 {
    lh: [f1 c2 ab2]:2 [db1 ab1 f2]:2 | 
    rh: f6:2.. eb6:8 |
}
measure 48 {
    lh: [bb1 f2 d3]:2 [bb0 f1 d2]:2 | 
    rh: d6:4. c6:8 d6:2 |
}

%% ==========================================
%% Section E: The Build-Up (Snare Rhythms & Dominant Pedal)
%% ==========================================
measure 49 {
    lh: [bb0 bb1]:1.ff.ped | 
    rh: (bb4:8 c5 d5):3/2 (eb5:8 f5 g5):3/2 (ab5:8 bb5 c6):3/2 (d6:8 eb6 f6):3/2 |
}
measure 50 {
    lh: [bb0 bb1]:1 | 
    rh: [g5 bb5 eb6 g6]:2.marc r:4 |
}
measure 51 {
    lh: [bb0 bb1]:1 | 
    rh: (bb4:8 c5 d5):3/2 (eb5:8 f5 g5):3/2 (ab5:8 bb5 c6):3/2 (d6:8 eb6 f6):3/2 |
}
measure 52 {
    lh: [bb0 bb1]:1 | 
    rh: [f5 ab5 d6 f6]:2.marc r:4 |
}
