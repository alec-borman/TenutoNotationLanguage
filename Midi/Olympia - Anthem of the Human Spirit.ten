        ]>
        lh: <[
            v1: eb1:4.mp [bb1 eb2 g2]:2.
                bb0:4.mp [f1 bb1 d2]:2.
                ab0:4.mp [eb1 ab1 c2]:2.
                bb0:4.mp [f1 bb1 d2]:2. |
                
